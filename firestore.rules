rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Companies collection
    match /companies/{username} {
      allow read: if true;
      allow write: if true;
    }

    // Settings collection
    match /settings/{document} {
      allow read: if true;
      allow write: if true;
    }
  }
}
